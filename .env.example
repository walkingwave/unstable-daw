# Copy to .env and fill in. Never commit .env.

# Stability AI API key, for the `api` backend (stable-audio-3 large).
# Get one at https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# DeepSeek API key, for the Studio agent behind /api/agent/plan.
# Get one from the DeepSeek platform API keys page.
DEEPSEEK_API_KEY=
BTG_AGENT_PROVIDER=deepseek
BTG_AGENT_MODEL=deepseek-v4-flash

# Which backend to use when a request does not specify one.
# One of: mock | local | api
BTG_DEFAULT_BACKEND=mock

# Optional: local Stable Audio 3 MLX checkout path. Defaults to:
# ../sa3-mlx-src/optimized/mlx relative to this repo.
BTG_MLX_ROOT=
# Optional: sm-music is fastest; medium sounds better if weights are present.
# BTG_MLX_DIT=sm-music
